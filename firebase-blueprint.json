{
  "entities": {
    "ProducerProfile": {
      "title": "ProducerProfile",
      "description": "Perfil técnico do produtor rural (V02 sem login, migrável para V19).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID canônico do produtor"
        },
        "deviceSessionId": {
          "type": "string",
          "description": "Identificador da sessão do aparelho"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Nome do produtor"
        },
        "cpf": {
          "type": "string",
          "maxLength": 14,
          "description": "CPF validado do produtor (com ou sem formatação)"
        },
        "phone": {
          "type": "string",
          "maxLength": 20,
          "description": "Telefone ou celular do produtor formatado"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de criação ISO 8601"
        }
      },
      "required": ["id", "deviceSessionId", "displayName", "createdAt"]
    },
    "Property": {
      "title": "Property",
      "description": "Propriedade agrícola (fazenda, sítio)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID canônico da propriedade"
        },
        "producerId": {
          "type": "string",
          "description": "ID do produtor proprietário"
        },
        "name": {
          "type": "string",
          "maxLength": 150,
          "description": "Nome da fazenda ou sítio"
        },
        "activityProfile": {
          "type": "string",
          "enum": ["coffee", "pasture", "mixed"],
          "description": "Perfil de atividade agrícola"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp de cadastro"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp de atualização"
        }
      },
      "required": ["id", "producerId", "name", "activityProfile", "createdAt"]
    },
    "Plot": {
      "title": "Plot",
      "description": "Talhão agrícola com geometria e cultura",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID canônico do talhão"
        },
        "propertyId": {
          "type": "string",
          "description": "ID da propriedade vinculada"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Nome do talhão"
        },
        "areaHa": {
          "type": "number",
          "description": "Área do talhão em hectares"
        },
        "active": {
          "type": "boolean",
          "description": "Se o talhão está ativo"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp de criação"
        }
      },
      "required": ["id", "propertyId", "name", "areaHa", "active", "createdAt"]
    },
    "FieldEvent": {
      "title": "FieldEvent",
      "description": "Evento de manejo, irrigação, corte ou ocorrência de campo (append-only)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID único do evento"
        },
        "plotId": {
          "type": "string",
          "description": "ID do talhão"
        },
        "type": {
          "type": "string",
          "enum": ["irrigation", "pasture_cut", "grazing_in", "grazing_out", "inspection", "occurrence", "note", "flowering_observed"],
          "description": "Tipo do evento"
        },
        "occurredAt": {
          "type": "string",
          "description": "Data e hora em que ocorreu"
        },
        "createdAt": {
          "type": "string",
          "description": "Data de registro"
        }
      },
      "required": ["id", "plotId", "type", "occurredAt", "createdAt"]
    },
    "SatelliteScene": {
      "title": "SatelliteScene",
      "description": "Cena real de satélite Sentinel-2 ou Sentinel-1 (Volume 04)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plotId": { "type": "string" },
        "provider": { "type": "string" },
        "mission": { "type": "string" },
        "acquiredAt": { "type": "string" },
        "cloudCoveragePct": { "type": "number" },
        "qualityFlag": { "type": "string" },
        "visualUrl": { "type": "string" }
      },
      "required": ["id", "provider", "mission", "acquiredAt"]
    },
    "PlotSatelliteMetric": {
      "title": "PlotSatelliteMetric",
      "description": "Métricas espectrais agregadas por talhão como NDVI, NDRE, SAVI (Volume 04 e 10)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plotId": { "type": "string" },
        "sceneId": { "type": "string" },
        "metric": { "type": "string" },
        "mean": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "confidence": { "type": "string" },
        "freshnessDate": { "type": "string" }
      },
      "required": ["id", "plotId", "metric", "mean"]
    },
    "WeatherSnapshot": {
      "title": "WeatherSnapshot",
      "description": "Snapshot meteorológico real Open-Meteo com ET0 e chuva (Volume 05)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "propertyId": { "type": "string" },
        "accumulatedRainLast7DaysMm": { "type": "number" },
        "source": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "propertyId", "updatedAt"]
    }
  },
  "firestore": {
    "/producers/{producerId}": {
      "schema": "ProducerProfile",
      "description": "Coleção de perfis técnicos dos produtores"
    },
    "/producers_by_cpf/{cpf}": {
      "schema": "ProducerProfile",
      "description": "Índice direto de consulta rápida de produtor por CPF"
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Coleção de propriedades rurais cadastradas"
    },
    "/plots/{plotId}": {
      "schema": "Plot",
      "description": "Coleção de talhões agrícolas com geometria"
    },
    "/field_events/{eventId}": {
      "schema": "FieldEvent",
      "description": "Histórico append-only de eventos de manejo e campo"
    },
    "/satellite_scenes/{sceneId}": {
      "schema": "SatelliteScene",
      "description": "Cenas de satélite reais adquiridas para os talhões"
    },
    "/plot_satellite_metrics/{metricId}": {
      "schema": "PlotSatelliteMetric",
      "description": "Séries de NDVI e vigor vegetal calculadas por talhão"
    },
    "/weather_snapshots/{propertyId}": {
      "schema": "WeatherSnapshot",
      "description": "Último snapshot do clima e evapotranspiração da fazenda"
    },
    "/irrigation_assessments/{plotId}": {
      "schema": "IrrigationAssessment",
      "description": "Balanço hídrico diário e necessidade de irrigação por talhão (Volume 09)"
    },
    "/phenology_events/{plotId}": {
      "schema": "CoffeePhenologyAssessment",
      "description": "Estágio fenológico e janela de florada do café (Volume 07)"
    },
    "/pasture_managements/{plotId}": {
      "schema": "PastureManagementAssessment",
      "description": "Controle de pastejo, corte e descanso de capim (Volume 08)"
    }
  }
}
