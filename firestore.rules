rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all (Pillar 1 / Global Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Producer Profiles
    match /producers/{producerId} {
      allow read, write: if true;
    }

    // Lookup direto por CPF
    match /producers_by_cpf/{cpf} {
      allow read, write: if true;
    }

    // Properties
    match /properties/{propertyId} {
      allow read, write: if true;
    }

    // Plots
    match /plots/{plotId} {
      allow read, write: if true;
    }

    // Field Events (append-only)
    match /field_events/{eventId} {
      allow read, create: if true;
      allow update, delete: if false; // Append-only
    }

    // Satellite Scenes (Volume 04)
    match /satellite_scenes/{sceneId} {
      allow read, write: if true;
    }

    // Plot Satellite Metrics (Volume 04)
    match /plot_satellite_metrics/{metricId} {
      allow read, write: if true;
    }

    // Weather Snapshots (Volume 05)
    match /weather_snapshots/{propertyId} {
      allow read, write: if true;
    }

    // Irrigation Assessments (Volume 09)
    match /irrigation_assessments/{plotId} {
      allow read, write: if true;
    }

    // Phenology Events (Volume 07)
    match /phenology_events/{plotId} {
      allow read, write: if true;
    }

    // Pasture Managements (Volume 08)
    match /pasture_managements/{plotId} {
      allow read, write: if true;
    }
  }
}
